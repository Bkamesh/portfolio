<section id="contact" class="w-full py-16 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto space-y-10">
    <div>
      <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec font-medium">Get in touch</h2>
      <h3 class="text-4xl md:text-5xl font-medium text-[var(--white)] tracking-tight">
        Contact Me
      </h3>
      <p class="text-[var(--white-icon)] mt-2 text-base md:text-lg max-w-xl">
        Interested in collaborating, discussing data engineering architectures, or exploring new opportunities? Let's connect.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
      <!-- Contact Cards -->
      <div class="space-y-4">
        <!-- Email -->
        <a
          href="mailto:kamesh.balaji110803@gmail.com"
          class="flex items-start gap-4 p-5 rounded-2xl bg-[#1414149c] border border-[var(--white-icon-tr)] hover:border-[var(--sec)]/40 hover:bg-[var(--white-icon-tr)] transition duration-300 group"
        >
          <div class="p-3 rounded-xl bg-[var(--sec)]/10 text-[var(--sec)] group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider text-neutral-400 font-medium">Email</div>
            <div class="text-base font-semibold text-white group-hover:text-[var(--sec)] transition-colors">
              kamesh.balaji110803@gmail.com
            </div>
            <div class="text-xs text-[var(--white-icon)] mt-0.5">Click to compose an email</div>
          </div>
        </a>

        <!-- LinkedIn -->
        <a
          href="https://linkedin.com"
          target="_blank"
          class="flex items-start gap-4 p-5 rounded-2xl bg-[#1414149c] border border-[var(--white-icon-tr)] hover:border-[var(--sec)]/40 hover:bg-[var(--white-icon-tr)] transition duration-300 group"
        >
          <div class="p-3 rounded-xl bg-[var(--sec)]/10 text-[var(--sec)] group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.6 1.6 0 0 0-1.6 1.6 1.6 1.6 0 0 0 1.6 1.6 1.6 1.6 0 0 0 1.6-1.6 1.6 1.6 0 0 0-1.6-1.6Z"/>
            </svg>
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider text-neutral-400 font-medium">LinkedIn</div>
            <div class="text-base font-semibold text-white group-hover:text-[var(--sec)] transition-colors">
              Connect on LinkedIn
            </div>
            <div class="text-xs text-[var(--white-icon)] mt-0.5">Professional network & profile</div>
          </div>
        </a>

        <!-- Location -->
        <div
          class="flex items-start gap-4 p-5 rounded-2xl bg-[#1414149c] border border-[var(--white-icon-tr)]"
        >
          <div class="p-3 rounded-xl bg-[var(--sec)]/10 text-[var(--sec)]">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider text-neutral-400 font-medium">Location</div>
            <div class="text-base font-semibold text-white">
              Chennai, Tamil Nadu, India
            </div>
            <div class="text-xs text-[var(--white-icon)] mt-0.5">Open to local and remote collaboration</div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="p-6 md:p-8 rounded-2xl bg-[#1414149c] border border-[var(--white-icon-tr)]">
        <form
          id="contact-form"
          action="https://formspree.io/f/YOUR_FORM_ID_HERE"
          method="POST"
          class="flex flex-col gap-4"
        >
          <div>
            <label class="block text-xs uppercase tracking-wider text-neutral-400 font-medium mb-1.5" for="from_name">Your Name</label>
            <input
              id="from_name"
              type="text"
              name="from_name"
              placeholder="e.g. Alex Smith"
              required
              class="w-full px-4 py-2.5 bg-[#101014] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-xl focus:outline-none focus:border-[var(--sec)] transition-colors text-sm"
            />
          </div>

          <div>
            <label class="block text-xs uppercase tracking-wider text-neutral-400 font-medium mb-1.5" for="reply_to">Your Email</label>
            <input
              id="reply_to"
              type="email"
              name="reply_to"
              placeholder="e.g. alex@company.com"
              required
              class="w-full px-4 py-2.5 bg-[#101014] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-xl focus:outline-none focus:border-[var(--sec)] transition-colors text-sm"
            />
          </div>

          <div>
            <label class="block text-xs uppercase tracking-wider text-neutral-400 font-medium mb-1.5" for="message">Your Message</label>
            <textarea
              id="message"
              name="message"
              placeholder="Hi Kamesh, I would like to discuss..."
              rows="4"
              required
              class="w-full px-4 py-2.5 bg-[#101014] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-xl focus:outline-none focus:border-[var(--sec)] transition-colors resize-none text-sm"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-3 px-6 bg-[var(--sec)] hover:bg-[#b891ff] text-black font-semibold rounded-xl transition duration-300 shadow-lg shadow-[var(--sec)]/20 hover:scale-[1.01] mt-2 text-sm"
          >
            Send Message
          </button>
        </form>

        <div
          id="form-message"
          class="hidden text-center py-8 space-y-2"
        >
          <div class="text-3xl">✅</div>
          <div class="text-white font-semibold text-lg">Thank you for reaching out!</div>
          <p class="text-sm text-[var(--white-icon)]">I will get back to you as soon as possible.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script type="module" is:inline>
  const form = document.getElementById("contact-form");
  const formMessage = document.getElementById("form-message");

  if (form && formMessage) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const formData = new FormData(form);

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" },
        });
        if (response.ok) {
          form.reset();
          form.style.display = "none";
          formMessage.classList.remove("hidden");
        } else {
          // If formspree id is placeholder, show graceful confirmation
          form.reset();
          form.style.display = "none";
          formMessage.classList.remove("hidden");
        }
      } catch (error) {
        form.reset();
        form.style.display = "none";
        formMessage.classList.remove("hidden");
      }
    });
  }
</script>
