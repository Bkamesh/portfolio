---
interface ExperienceItem {
  company: string;
  location: string;
  roles: {
    title: string;
    period: string;
    isCurrent?: boolean;
  }[];
  description: string[];
  techStack: string[];
}

const experiences: ExperienceItem[] = [
  {
    company: "Aravind Eye Care System – Aravind Eye Hospital",
    location: "Tamil Nadu, India",
    roles: [
      {
        title: "Data Engineer",
        period: "June 2024 – Present",
        isCurrent: true,
      },
      {
        title: "Intern",
        period: "Feb 2024 – May 2024",
      },
    ],
    description: [
      "Built multi-region CDC pipelines using Kafka and Debezium for reliable data replication across distributed hospital systems.",
      "Developed asynchronous Python consumers for event ordering, foreign-key integrity, and ACID guarantees.",
      "Built a metadata-driven Airflow (MWAA) framework for automated pipeline orchestration and scheduling.",
      "Engineered a cloud healthcare analytical platform using Amazon Aurora PostgreSQL, Amazon Redshift, and dbt with HL7 FHIR standards.",
      "Architected a real-time streaming lakehouse PoC using Flink CDC, Flink SQL, Apache Paimon, and Trino for incremental changelog processing.",
      "Developed .NET microservices and reporting solutions for clinical and operational workflows.",
      "Implemented Prometheus, Grafana, and Loki for end-to-end pipeline monitoring, alerting, and troubleshooting.",
    ],
    techStack: [
      "Kafka",
      "Debezium",
      "Python",
      "dbt",
      "Airflow (MWAA)",
      "Amazon Redshift",
      "PostgreSQL",
      "Apache Flink",
      "Apache Paimon",
      "Trino",
      "HL7 FHIR",
      ".NET",
      "Prometheus",
      "Grafana",
      "Loki",
    ],
  },
];

const competencies = [
  {
    category: "Data Engineering & Streaming",
    items: ["dbt", "Airflow (MWAA)", "Kafka", "Debezium", "Apache Flink", "Spark", "Trino", "Ranger"],
  },
  {
    category: "Open Table Formats & Storage",
    items: ["Apache Paimon", "Apache Iceberg"],
  },
  {
    category: "Databases (OLTP & OLAP)",
    items: ["PostgreSQL", "Amazon Redshift", "MS SQL Server", "Amazon Aurora"],
  },
  {
    category: "Programming & Frameworks",
    items: ["Python", "SQL", "C#", "ASP.NET Core Web API", "asyncio"],
  },
  {
    category: "Cloud, DevOps & Observability",
    items: ["AWS (MWAA, Redshift, Aurora)", "Docker", "Kubernetes", "Jenkins", "Git", "Prometheus", "Grafana", "Loki"],
  },
  {
    category: "BI, Reporting & Standards",
    items: ["HL7 FHIR Standards", "Power BI", "SSRS", "FastReport.NET", "Dapper"],
  },
];

const achievements = [
  {
    title: "Above and Beyond Award – AUROiTECH (2025)",
    type: "Award",
    description:
      "Recognized for outstanding contributions to mission-critical hospital data integration and clinical reporting systems at Aravind Eye Care System.",
  },
  {
    title: "IEEE Xplore Publication – ICSSS'23",
    type: "Publication",
    description:
      'Co-authored research paper: "Supportive System for Hemiplegic Patients with Health Monitoring Capabilities", published in IEEE Xplore.',
  },
];

const education = [
  {
    institution: "Saveetha Engineering College",
    degree: "B.E. Biomedical Engineering",
    period: "2020 – 2024",
  },
  {
    institution: "Annai Sarada Matric. Hr. Sec. School",
    degree: "Higher Secondary Certificate (H.S.C)",
    period: "2020",
  },
  {
    institution: "Annai Sarada Matric. Hr. Sec. School",
    degree: "Secondary School Leaving Certificate (S.S.L.C)",
    period: "2018",
  },
];
---

<section id="experience" class="py-16 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="max-w-5xl mx-auto space-y-16">
    <!-- Header -->
    <div>
      <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec font-medium">Career Path</h2>
      <h3 class="text-4xl md:text-5xl font-medium tracking-tight">Experience & Credentials</h3>
    </div>

    <!-- Work Experience -->
    <div class="space-y-6">
      <h4 class="text-2xl font-semibold flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--sec)]"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
        <span>Work Experience</span>
      </h4>

      {
        experiences.map((exp) => (
          <div class="p-6 md:p-8 rounded-2xl bg-[#1414149c] border border-[var(--white-icon-tr)] space-y-6">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-[#ffffff10] pb-6">
              <div>
                <h5 class="text-2xl font-bold text-white">{exp.company}</h5>
                <p class="text-sm text-[var(--white-icon)] mt-1">{exp.location}</p>
              </div>

              <div class="flex flex-col sm:flex-row gap-3">
                {exp.roles.map((role) => (
                  <div class={`px-4 py-2 rounded-xl text-sm border ${
                    role.isCurrent 
                      ? 'border-[var(--sec)] bg-[var(--sec)]/10 text-[var(--sec)] font-medium' 
                      : 'border-[var(--white-icon-tr)] bg-black/30 text-[var(--white-icon)]'
                  }`}>
                    <div class="font-semibold text-white">{role.title}</div>
                    <div class="text-xs opacity-80">{role.period}</div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Bullet points -->
            <ul class="space-y-3 text-sm md:text-base text-[var(--white-icon)]">
              {exp.description.map((point) => (
                <li class="flex items-start gap-3">
                  <span class="text-[var(--sec)] mt-1 font-bold">▹</span>
                  <span class="leading-relaxed">{point}</span>
                </li>
              ))}
            </ul>

            <!-- Tech badges -->
            <div class="pt-4 border-t border-[#ffffff10] flex flex-wrap gap-2">
              {exp.techStack.map((tech) => (
                <span class="px-2.5 py-1 text-xs rounded-lg bg-[var(--white-icon-tr)] text-[var(--white)] border border-[var(--white-icon-tr)]">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <!-- Core Competencies Grid -->
    <div class="space-y-6">
      <h4 class="text-2xl font-semibold flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--sec)]"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
        <span>Technical Skills & Competencies</span>
      </h4>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          competencies.map((comp) => (
            <div class="p-5 rounded-2xl bg-[#1414149c] border border-[var(--white-icon-tr)] flex flex-col justify-between">
              <div>
                <h5 class="text-sm font-semibold text-[var(--sec)] mb-3">{comp.category}</h5>
                <div class="flex flex-wrap gap-1.5">
                  {comp.items.map((item) => (
                    <span class="px-2 py-0.5 text-xs rounded-md bg-[#1f1f1f] text-[var(--white)] border border-[#ffffff10]">
                      {item}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Awards, Publications & Education Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Awards & Publications -->
      <div class="space-y-6">
        <h4 class="text-2xl font-semibold flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--sec)]"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
          <span>Honors & Publications</span>
        </h4>

        <div class="space-y-4">
          {
            achievements.map((item) => (
              <div class="p-5 rounded-2xl bg-[#1414149c] border border-[var(--white-icon-tr)] space-y-2">
                <div class="flex items-center justify-between">
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-[var(--sec)]/15 text-[var(--sec)] border border-[var(--sec)]/30">
                    {item.type}
                  </span>
                </div>
                <h5 class="text-lg font-semibold text-white">{item.title}</h5>
                <p class="text-sm text-[var(--white-icon)] leading-relaxed">{item.description}</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Education -->
      <div class="space-y-6">
        <h4 class="text-2xl font-semibold flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--sec)]"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
          <span>Education</span>
        </h4>

        <div class="space-y-4">
          {
            education.map((edu) => (
              <div class="p-5 rounded-2xl bg-[#1414149c] border border-[var(--white-icon-tr)] flex items-start justify-between gap-4">
                <div>
                  <h5 class="text-lg font-semibold text-white">{edu.institution}</h5>
                  <p class="text-sm text-[var(--sec)] font-medium mt-0.5">{edu.degree}</p>
                </div>
                <span class="px-3 py-1 rounded-xl text-xs bg-[var(--white-icon-tr)] text-[var(--white-icon)] border border-[var(--white-icon-tr)] whitespace-nowrap">
                  {edu.period}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

